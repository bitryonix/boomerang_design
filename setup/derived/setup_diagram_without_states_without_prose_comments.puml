@startuml setup_diagram_without_states
skinparam sequenceMessageAlign left
title Setup Sequence Diagram (Without States)
box "User Side" #AliceBlue
actor User order 1 #LightCyan
participant Iso order 2 #LightBlue
participant Boomlet order 3 #LightPink
participant ST order 4 #Violet
participant Boomletwo order 4 #LightGray
participant Niso order 5 #LightGreen
participant Phone order 6 #CadetBlue
end box
participant WT order 98 #Red
participant SAR order 99 #Yellow
actor Peers order 100

legend left
encrypt_for_<peer> and decrypt_from_<peer> use CBC-CMAC directional channels
with the acting device's identity key and the named peer's public key.
Decryption authenticates before returning content.
endlegend

autonumber "<b>[00]"
note over User, SAR
<b>PARAMETERS
# #define PROTOCOL_VERSION
# #define MAX_TRIES_FOR_DIGGING_GAME_IN_BLOCKS
# #define MIN_TRIES_FOR_DIGGING_GAME_IN_BLOCKS
end note
group SAR sign-up

' Step 1
User o-> Phone:  <b>SetupPhoneInput1 \n doxing_password \n sar_id \n static_doxing_data
hnote over Phone #Lavender:  doxing_password_bytes := utf8(doxing_password) \n doxing_key := tagged_sha256("Boomerang/doxing_key", doxing_password_bytes) \n sar_pubkey := sar_id.sar_pubkey \n sar_pubkey_bytes := canonical_public_key_bytes(sar_pubkey) \n doxing_key_for_sar := tagged_sha256("Boomerang/doxing_key_for_sar", doxing_key || sar_pubkey_bytes) \n doxing_data_identifier := tagged_sha256("Boomerang/doxing_data_identifier", doxing_key_for_sar)

' Step 2
Phone o-> SAR:  <b>SetupPhoneSarMessage1 \n doxing_data_identifier
hnote over SAR #Lavender:  service_fee_invoice := invoice bound to doxing_data_identifier and PROTOCOL_VERSION \n payment_deadline := deadline for service_fee_invoice \n sar_service_fee_payment_info := SarServiceFeePaymentInfo{ \n service_fee_invoice: service_fee_invoice, \n payment_deadline: payment_deadline, \n sar_id: sar_id \n }.

' Step 3
SAR o-> Phone:  <b>SetupSarPhoneMessage1 \n sar_service_fee_payment_info

' Step 4
Phone o-> User:  <b>SetupPhoneOutput1 \n sar_service_fee_payment_info
hnote over User #Lavender:  sar_service_fee_payment_receipts := pay(sar_service_fee_payment_info)

' Step 5
User o-> Phone:  <b>SetupPhoneInput2 \n sar_service_fee_payment_receipts
hnote over Phone #Lavender:  static_doxing_data_cbc_cmac_keys := derive_cbc_cmac_keys(doxing_key_for_sar, "Boomerang/sar_stored_data") \n static_doxing_data_encrypted_by_doxing_key_for_sar := cbc_cmac_encrypt(keys: \n static_doxing_data_cbc_cmac_keys, \n context: canonical_encode("Boomerang", PROTOCOL_VERSION, "sar_static_data", doxing_data_identifier), \n content: static_doxing_data) \n device_id := random_bytes(32) \n upload_id := random_bytes(32) \n upload_seq_num := 0 \n device_data_key := kdf_counter_cmac_aes256(doxing_key_for_sar, "Boomerang/sar_dynamic_device_data_key/v1", canonical_encode(device_id), 32) \n dynamic_update_auth_key := kdf_counter_cmac_aes256(doxing_key_for_sar, "Boomerang/sar_dynamic_update_auth_key/v1", canonical_encode(PROTOCOL_VERSION, doxing_data_identifier), 32) \n dynamic_context := canonical_encode("Boomerang", PROTOCOL_VERSION, "sar_dynamic_data", doxing_data_identifier, device_id, upload_id, upload_seq_num) \n dynamic_doxing_data_cbc_cmac_keys := derive_cbc_cmac_keys(device_data_key, "Boomerang/sar_stored_data") \n dynamic_doxing_data_encrypted_by_device_data_key := cbc_cmac_encrypt(keys: \n dynamic_doxing_data_cbc_cmac_keys, \n context: dynamic_context, \n content: dynamic_doxing_data) \n dynamic_upload_cmac := aes256_cmac(dynamic_update_auth_key, \n canonical_encode("Boomerang/sar_dynamic_upload/v1", PROTOCOL_VERSION, doxing_data_identifier, device_id, upload_id, upload_seq_num, dynamic_doxing_data_encrypted_by_device_data_key)) \n first_dynamic_doxing_data_upload := DynamicRescueUpload{doxing_data_identifier, device_id, upload_id, upload_seq_num, dynamic_doxing_data_encrypted_by_device_data_key, dynamic_upload_cmac}

' Step 6
Phone o-> SAR:  <b>SetupPhoneSarMessage2 \n sar_service_fee_payment_receipts \n doxing_data_identifier \n static_doxing_data_encrypted_by_doxing_key_for_sar \n dynamic_update_auth_key \n first_dynamic_doxing_data_upload

' Step 7
SAR --> Phone:  <b>SetupSarPhoneMessage2 \n dynamic_doxing_data_upload_receipt_signed_by_sar

' Step 8
Phone o-> User:  <b>SetupPhoneOutput2 \n magic: "setup_sar_registered_and_connected_to_phone"
end group
group Duress setup

' Step 9
User o-> Iso:  <b>SetupIsoInput1 \n network \n account \n key_index \n entropy_bytes \n passphrase \n doxing_password \n sar_id
hnote over Iso #Lavender:  coin_type := 0 if network is mainnet else 1 \n mnemonic := mnemonic_from_entropy(entropy_bytes) \n master_xpriv_0 := derive_master_xpriv(mnemonic, passphrase) \n purpose_xpriv_0 := derive_child_xpriv(master_xpriv_0, 52102, hardened: true) \n coin_xpriv_0 := derive_child_xpriv(purpose_xpriv_0, coin_type, hardened: true) \n account_xpriv_0 := derive_child_xpriv(coin_xpriv_0, account, hardened: true) \n external_xpriv_0 := derive_child_xpriv(account_xpriv_0, 0, hardened: false) \n normal_privkey_0 := derive_child_xpriv(external_xpriv_0, key_index, hardened: false) \n normal_pubkey_0 := derive_public_key(normal_privkey_0) \n doxing_password_bytes := utf8(doxing_password) \n doxing_key := tagged_sha256("Boomerang/doxing_key", doxing_password_bytes)

' Step 10
Iso o-> Boomlet:  <b>SetupIsoBoomletMessage1 \n normal_pubkey_0 \n doxing_key \n sar_id
hnote over Boomlet #Lavender:  boomlet_0_identity_privkey := generate_private_key() \n boomlet_0_boom_musig2_privkey_share := generate_private_key() \n boomlet_0_boom_musig2_pubkey_share := derive_public_key(boomlet_0_boom_musig2_privkey_share) \n boomlet_0_identity_pubkey := derive_public_key(boomlet_0_identity_privkey) \n boom_pubkey_0 := derive_musig2_public_key(boomlet_0_boom_musig2_pubkey_share, normal_pubkey_0)

' Step 11
Boomlet -> Iso:  <b>SetupBoomletIsoMessage1 \n boomlet_0_identity_pubkey

' Step 12
Iso o-> ST:  <b>SetupIsoStMessage1 \n boomlet_0_identity_pubkey
hnote over ST #Lavender:  st_0_identity_privkey := generate_private_key() \n st_0_identity_pubkey := derive_public_key(st_0_identity_privkey)

' Step 13
ST o-> Iso:  <b>SetupStIsoMessage1 \n st_0_identity_pubkey

' Step 14
Iso o-> Boomlet:  <b>SetupIsoBoomletMessage2 \n st_0_identity_pubkey
hnote over Boomlet #Lavender:  duress_check_space := DuressCheckSpace{space: random_permutation([1..193])} \n duress_check_space_with_nonce := MessageWithNonce{ \n content: duress_check_space \n nonce: random_bytes(32) } \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st := encrypt_for_st_0(context: canonical_encode("duress_challenge"), \n content: duress_check_space_with_nonce)

' Step 15
Boomlet o-> Iso:  <b>SetupBoomletIsoMessage2 \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st

' Step 16
Iso o-> ST:  <b>SetupIsoStMessage2 \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st
hnote over ST #Lavender:  duress_check_space_with_nonce := decrypt_from_boomlet_0(context: canonical_encode("duress_challenge"), \n envelope: duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st) \n duress_check_space := duress_check_space_with_nonce.content \n duress_display_columns, retained_display_maps := create_duress_display_columns(duress_check_space.space)

' Step 17
ST o-> User:  <b>SetupStOutput1 \n duress_display_columns
hnote over User #Lavender:  user_selection := select_one_from_each(duress_display_columns)

' Step 18
User o-> ST:  <b>SetupStInput1 \n user_selection
hnote over ST #Lavender:  duress_signal_index := map_to_original_indices(user_selection, \n retained_display_maps) \n duress_signal_index_with_nonce := MessageWithNonce{ \n content: duress_signal_index \n nonce: duress_check_space_with_nonce.nonce} \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0 := encrypt_for_boomlet_0(context: canonical_encode("duress_response"), \n content: duress_signal_index_with_nonce)

' Step 19
ST o-> Iso:  <b>SetupStIsoMessage2 \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0

' Step 20
Iso o-> Boomlet:  <b>SetupIsoBoomletMessage3 \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0
hnote over Boomlet #Lavender:  duress_signal_index_with_nonce := decrypt_from_st_0(context: canonical_encode("duress_response"), \n envelope: duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0)
hnote over Boomlet #Lavender:  duress_consent_set := \n duress_check_space.space[duress_signal_index_with_nonce.content.indices]
hnote over Boomlet #Lavender:  duress_check_space := DuressCheckSpace{space: random_permutation([1..193])} \n duress_check_space_with_nonce := MessageWithNonce{ \n content: duress_check_space \n nonce: random_bytes(32) } \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st := encrypt_for_st_0(context: canonical_encode("duress_challenge"), \n content: duress_check_space_with_nonce)

' Step 21
Boomlet -> Iso:  <b>SetupBoomletIsoMessage3 \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st

' Step 22
Iso o-> ST:  <b>SetupIsoStMessage3 \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st
hnote over ST #Lavender:  duress_check_space_with_nonce := decrypt_from_boomlet_0(context: canonical_encode("duress_challenge"), \n envelope: duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st) \n duress_check_space := duress_check_space_with_nonce.content \n duress_display_columns, retained_display_maps := create_duress_display_columns(duress_check_space.space)

' Step 23
ST o-> User:  <b>SetupStOutput2 \n duress_display_columns
hnote over User #Lavender:  user_selection := select_one_from_each(duress_display_columns)

' Step 24
User o-> ST:  <b>SetupStInput2 \n user_selection
hnote over ST #Lavender:  duress_signal_index := map_to_original_indices(user_selection, \n retained_display_maps) \n duress_signal_index_with_nonce := MessageWithNonce{ \n content: duress_signal_index \n nonce: duress_check_space_with_nonce.nonce \n } \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0 := encrypt_for_boomlet_0(context: canonical_encode("duress_response"), \n content: duress_signal_index_with_nonce)

' Step 25
ST o-> Iso:  <b>SetupStIsoMessage3 \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0

' Step 26
Iso o-> Boomlet:  <b>SetupIsoBoomletMessage4 \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0
hnote over Boomlet #Lavender:  duress_signal_index_with_nonce := decrypt_from_st_0(context: canonical_encode("duress_response"), \n envelope: duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0)
hnote over Boomlet #Lavender:  consent_counter := 0 \n under_duress := false

' Step 27
Boomlet o-> Iso:  <b>SetupBoomletIsoMessage4 \n magic: "setup_duress_finished"
end group
group Boomerang parameters setup

' Step 28
Iso o-> User:  <b>SetupIsoOutput1 \n mnemonic

' Step 29
User o-> Niso:  <b>SetupNisoInput1 \n network \n rpc_client_url \n rpc_client_auth

' Step 30
Niso o-> Boomlet:  <b>SetupNisoBoomletMessage1 \n magic: "setup_initialized"
hnote over Boomlet #Lavender:  peer_0_tor_secret_key := generate_private_key() \n peer_0_setup_nonce := random_bytes(32) \n peer_0_tor_address := derive_tor_address(peer_0_tor_secret_key) \n peer_0_id := PeerId{ \n boom_pubkey: boom_pubkey_0, \n normal_pubkey: normal_pubkey_0, \n boomlet_identity_pubkey: boomlet_0_identity_pubkey \n } \n peer_0_setup_identity_record := PeerSetupRecord{peer_id: peer_0_id, peer_setup_nonce: peer_0_setup_nonce, \n tor_address: peer_0_tor_address} \n peer_0_setup_identity_record_signed_by_boomlet_0 := sign_message(boomlet_0_identity_privkey, \n "Boomerang/setup/peer_setup_record", peer_0_setup_identity_record)

' Step 31
Boomlet o-> Niso:  <b>SetupBoomletNisoMessage1 \n peer_0_tor_secret_key \n peer_0_setup_identity_record_signed_by_boomlet_0
hnote over Niso #Lavender:  peer_0_tor_address := derive_tor_address(peer_0_tor_secret_key).

' Step 32
Niso o-> ST:  <b>SetupNisoStMessage1 \n peer_0_setup_identity_record_signed_by_boomlet_0

' Step 33
ST o-> User:  <b>SetupStOutput3 \n peer_0_setup_identity_record_signed_by_boomlet_0

' Step 34
User <--> Peers:  <b>SetupUserPeersOutOfBandMessage1 \n peer_0_setup_identity_record_signed_by_boomlet_0
hnote over User #Lavender:  peer_setup_records_collection := \n Collection<peer_i_setup_identity_record_signed_by_boomlet_i> [0 <= i <= 4]

' Step 35
User o-> Niso:  <b>SetupNisoInput2 \n peer_setup_records_collection \n wt_ids_collection \n milestone_block_collection
hnote over Niso #Lavender:  Connect to peer_i_setup_identity_record_signed_by_boomlet_i.content.tor_address [1 \n <= i <= 4]. \n ordered_peer_setup_records := peer_setup_records_collection sorted by encoded Boomlet identity pubkey \n active_wt_id := wt_ids_collection[0] \n wt_pubkey := active_wt_id.wt_pubkey

' Step 36
Niso o-> Boomlet:  <b>SetupNisoBoomletMessage2 \n ordered_peer_setup_records \n wt_ids_collection \n milestone_block_collection
group ST review of BoomerangParamsSeed commitment
hnote over Boomlet #Lavender:  peer_ids_collection := Collection<ordered_peer_setup_records.content.peer_id> \n [0 <= i <= 4] \n ordered_boomlet_identity_pubkeys := \n Collection<ordered_peer_setup_records.content.peer_id.boomlet_identity_pubkey> [0 <= i <= 4] \n active_wt_id := wt_ids_collection[0] \n wt_pubkey := active_wt_id.wt_pubkey \n boomerang_params_seed := BoomerangParamsSeed{ordered_peer_setup_records: ordered_peer_setup_records, wt_ids: \n wt_ids_collection, milestone_blocks: milestone_block_collection} \n setup_instance_id := tagged_sha256("Boomerang/setup_instance_id", canonical_encode(PROTOCOL_VERSION, \n boomerang_params_seed)) \n setup_instance_id_with_nonce := MessageWithNonce{ \n content: setup_instance_id \n nonce: random_bytes(32) \n } \n setup_instance_id_with_nonce_encrypted_by_boomlet_0_for_st := encrypt_for_st_0(context: canonical_encode("params_review", setup_instance_id), \n content: setup_instance_id_with_nonce)

' Step 37
Boomlet o-> Niso:  <b>SetupBoomletNisoMessage2 \n setup_instance_id \n setup_instance_id_with_nonce_encrypted_by_boomlet_0_for_st

' Step 38
Niso o-> ST:  <b>SetupNisoStMessage2 \n setup_instance_id \n setup_instance_id_with_nonce_encrypted_by_boomlet_0_for_st \n ordered_peer_setup_records \n wt_ids_collection \n milestone_block_collection
hnote over ST #Lavender:  setup_instance_id_with_nonce := decrypt_from_boomlet_0(context: canonical_encode("params_review", setup_instance_id), \n envelope: setup_instance_id_with_nonce_encrypted_by_boomlet_0_for_st) \n decrypted_setup_instance_id := setup_instance_id_with_nonce.content \n boomerang_params_seed := BoomerangParamsSeed{ordered_peer_setup_records: ordered_peer_setup_records, wt_ids: \n wt_ids_collection, milestone_blocks: milestone_block_collection} \n recomputed_setup_instance_id := tagged_sha256("Boomerang/setup_instance_id", \n canonical_encode(PROTOCOL_VERSION, boomerang_params_seed))

' Step 39
ST o-> User:  <b>SetupStOutput4 \n ordered_peer_setup_records \n wt_ids_collection \n milestone_block_collection
hnote over User #Lavender:  expected_ordered_peer_setup_records := peer_setup_records_collection sorted by \n encoded Boomlet identity pubkey

' Step 40
User o-> ST:  <b>SetupStInput3 \n magic: "setup_user_verified_peer_ids_and_wt_ids_received_with_those_registered_before"
hnote over ST #Lavender:  setup_instance_id_with_nonce_signed_by_st := sign_message(st_0_identity_privkey, \n "Boomerang/setup/params_review_approval", setup_instance_id_with_nonce) \n setup_instance_id_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0 := encrypt_for_boomlet_0(context: canonical_encode("params_review_approval", setup_instance_id), \n content: setup_instance_id_with_nonce_signed_by_st)

' Step 41
ST o-> Niso:  <b>SetupStNisoMessage1 \n setup_instance_id_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0

' Step 42
Niso o-> Boomlet:  <b>SetupNisoBoomletMessage3 \n setup_instance_id_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0
hnote over Boomlet #Lavender:  setup_instance_id_with_nonce_signed_by_st := decrypt_from_st_0(context: canonical_encode("params_review_approval", setup_instance_id), \n envelope: setup_instance_id_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0)
end group
hnote over Boomlet #Lavender:  boomerang_descriptor := construct_boomerang_descriptor(peer_ids_collection, \n milestone_block_collection) \n boomerang_params := BoomerangParams{ \n setup_instance_id: setup_instance_id, \n peer_ids: peer_ids_collection, \n wt_ids: wt_ids_collection, \n milestone_blocks: milestone_block_collection, \n boomerang_descriptor: boomerang_descriptor \n } \n boomerang_params_fingerprint := tagged_sha256("Boomerang/boomerang_params", \n canonical_encode(boomerang_params)) \n boomerang_params_fingerprint_signed_by_boomlet_0 := sign_message(boomlet_0_identity_privkey, \n "Boomerang/setup/agreement", boomerang_params_fingerprint)
group BoomerangParams acknowledgement between Boomlets

' Step 43 -1
Boomlet o-> Niso:  <b>SetupBoomletNisoMessage3 \n boomerang_params_fingerprint_signed_by_boomlet_0

' Step 44 -2
Niso <-> Peers:  <b>SetupNisoPeerNisoMessage1 \n boomerang_params_fingerprint_signed_by_boomlet_i [0 <= i <= 4]
