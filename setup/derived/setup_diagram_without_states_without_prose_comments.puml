autonumber stop
Peers o-> WT:  <b>SetupNisoWtMessage1 \n setup_instance_id \n boomerang_params_fingerprint_signed_by_boomlet_i \n peer_i_setup_identity_record_signed_by_boomlet_i [1<=i<=4]
autonumber resume 1 "<b>[00]"
hnote over WT #Lavender:  boomerang_params_fingerprint := \n boomerang_params_fingerprint_signed_by_boomlet_0.content
hnote over WT #Lavender:  boomlet_0_identity_pubkey := \n peer_0_setup_identity_record_signed_by_boomlet_0.content.peer_id.boomlet_identity_pubkey \n wt_pubkey := wt_id.wt_pubkey \n service_fee_invoice := peer-specific invoice bound to setup_instance_id \n payment_deadline := deadline for service_fee_invoice \n wt_service_fee_payment_info := WtServiceFeePaymentInfo{ \n setup_instance_id: setup_instance_id, \n service_fee_invoice: service_fee_invoice, \n payment_deadline: payment_deadline, \n wt_id: wt_id \n }

