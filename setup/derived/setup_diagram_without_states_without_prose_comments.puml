hnote over Boomlet #Lavender:  setup_checkpoint := tagged_sha256("Boomerang/setup_phase_checkpoint", \n canonical_encode(setup_instance_id, "wt_ready", setup_checkpoint)) \n setup_checkpoint_signed_by_boomlet_0 := sign_message(boomlet_0_identity_privkey, \n "Boomerang/setup/phase_checkpoint", setup_checkpoint)

