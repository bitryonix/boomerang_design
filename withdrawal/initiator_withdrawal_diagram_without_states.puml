end
group ping pong Game
hnote over Boomlet #Lavender:  mystery := random_integer(MIN_TRIES_FOR_DIGGING_GAME_IN_BLOCKS, \n MAX_TRIES_FOR_DIGGING_GAME_IN_BLOCKS) \n counter := 0 \n reached_boomlets_collection: Collection.new()
hnote over Boomlet #Lavender:  ping_seq_num := 0 \n reached_mystery_flag := 0 \n last_seen_block := niso_0_event_block_height \n _peer_0_ping := Ping{ \n approved_withdrawal_id: approved_withdrawal_id, \n last_seen_block: last_seen_block, \n ping_seq_num: ping_seq_num, \n reached_mystery_flag: reached_mystery_flag \n }
