hnote over SAR #Lavender:  doxing_data_identifier := derived_doxing_data_identifier \n doxing_key_for_sar := duress_placeholder_plaintext \n static_doxing_data := cbc_cmac_decrypt(keys: derive_cbc_cmac_keys(doxing_key_for_sar, \n "Boomerang/sar_stored_data"), context: canonical_encode("Boomerang", PROTOCOL_VERSION, "sar_static_data", doxing_data_identifier), envelope: \n static_doxing_data_encrypted_by_doxing_key_for_sar) \n retained_dynamic_doxing_data_uploads := all_retained_uploads(doxing_data_identifier) \n dynamic_doxing_data_history := [] \n for each retained_dynamic_doxing_data_upload in retained_dynamic_doxing_data_uploads: \n   device_data_key := kdf_counter_cmac_aes256(doxing_key_for_sar, \n   "Boomerang/sar_dynamic_device_data_key/v1", \n   canonical_encode(retained_dynamic_doxing_data_upload.device_id), 32) \n   dynamic_doxing_data_cbc_cmac_keys := derive_cbc_cmac_keys(device_data_key, "Boomerang/sar_stored_data") \n   dynamic_doxing_data := cbc_cmac_decrypt(keys: dynamic_doxing_data_cbc_cmac_keys, \n   context: canonical_encode("Boomerang", PROTOCOL_VERSION, "sar_dynamic_data", doxing_data_identifier, \n   retained_dynamic_doxing_data_upload.device_id, retained_dynamic_doxing_data_upload.upload_id, \n   retained_dynamic_doxing_data_upload.upload_seq_num), \n   envelope: retained_dynamic_doxing_data_upload.dynamic_doxing_data_encrypted_by_device_data_key) \n   dynamic_doxing_data_history.append(dynamic_doxing_data) \n end for \n save(approved_withdrawal_id, boomlet_0_identity_pubkey, duress_placeholder.iv) \n Enter SEARCH_AND_RESCUE_MODE
end
